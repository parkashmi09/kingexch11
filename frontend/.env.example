# Every endpoint the app talks to lives here — src/config.js hardcodes no host,
# so a key missing from this file resolves to '' and the request goes nowhere.
# Copy to .env and fill in.

# ========================Backend Connection Configuration=============
# NOTE the /api suffix — the services call paths like `/user/login`
VITE_API_URL=https://api.tenexchn.com/api
VITE_SOCKET_URL=https://api.tenexchn.com
VITE_BRAND=tenexch
VITE_CASINO_STREAM_BASE=https://stream-s-43.uhdmovies.online/casino-stream?id=

# ========================Sports Stream Configuration===================
VITE_SPORTS_STREAM_BASE=https://stream-s-43.uhdmovies.online/sports-stream?id=
VITE_SCORECARD_BASE=https://scorecard.daimond-api.site/

# Live cricket score socket (Socket.IO v2 / EIO=3)
VITE_SCORE_SOCKET_URL=wss://dimclscore.external247services.com

# ========================Betting Configuration=========================
VITE_BET_BUFFER_SECONDS=5
VITE_FANCY_BUFFER_SECONDS=3
VITE_CASINO_BUFFER_SECONDS=5
