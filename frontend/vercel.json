{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?__prefix=api&__path=:path*" },
    { "source": "/socket.io/:path*", "destination": "/api/proxy?__prefix=socket.io&__path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
