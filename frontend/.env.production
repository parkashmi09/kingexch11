# Production build settings (npm run build), committed so a deploy needs no
# dashboard variables. Values set in the host's dashboard override these.
#
# The API and socket are same-origin: the browser calls /api and /socket.io on
# the site itself, and the host proxies them to the backend (Vercel: vercel.json
# + api/proxy.js; `vite preview`: the proxy in vite.config.js). That keeps the
# backend's CORS whitelist out of the picture for every domain the site runs on.
# Don't set these to the backend's full URL; the browser would then call it
# directly and be blocked by CORS on any domain the backend hasn't whitelisted.
VITE_API_URL=/api
VITE_SOCKET_URL=

VITE_BRAND=tenexch
VITE_CASINO_STREAM_BASE=https://stream-s-43.uhdmovies.online/casino-stream?id=
VITE_SPORTS_STREAM_BASE=https://stream-s-43.uhdmovies.online/sports-stream?id=
VITE_SCORECARD_BASE=https://scorecard.daimond-api.site/
VITE_SCORE_SOCKET_URL=wss://dimclscore.external247services.com

VITE_BET_BUFFER_SECONDS=5
VITE_FANCY_BUFFER_SECONDS=3
VITE_CASINO_BUFFER_SECONDS=5
